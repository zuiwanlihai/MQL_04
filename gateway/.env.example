# MT5 网关配置样例 —— 复制为 .env 后按需修改
# 服务监听：仅本机访问用 127.0.0.1；供后端远程访问用 0.0.0.0
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
# 网关访问密钥（必填，且须与平台后端一致）——**留空或缺失时网关拒绝启动**：
# 空密钥意味着所有交易接口都等于无鉴权。请用「配对码」自动写入
# （python -m app.pairing --server http://<后端地址> --code <配对码>），
# 或手工填一段足够长的随机串后同步到后端 .env。样例故意不预置任何值。
#GATEWAY_API_KEY=
# MT5 终端路径与默认账户（也可登录后通过平台页面绑定）
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# 交易灰度：仅白名单内的登录号允许真实下单
TRADE_ENABLED=true
TRADE_ALLOWED_LOGINS=
