# MT5 网关配置样例 —— 复制为 .env 后按需修改
# 服务监听：仅本机访问用 127.0.0.1；供后端远程访问用 0.0.0.0
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
# 网关访问密钥（与平台后端一致；推荐走「配对码」自动写入，无需手抄）
GATEWAY_API_KEY=
# MT5 终端路径与默认账户（也可登录后通过平台页面绑定）
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# 交易灰度：仅白名单内的登录号允许真实下单
TRADE_ENABLED=true
TRADE_ALLOWED_LOGINS=
