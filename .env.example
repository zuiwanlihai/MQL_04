# ============================
# Environment Variables
# MT5 Web Quantitative Trading Platform
#
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your secrets and overrides
# 3. NEVER commit .env to version control
# ============================

# ──────────── Database ────────────
DATABASE_URL=postgresql+asyncpg://mt5user:mt5password@postgres:5432/mt5_quant
DATABASE_URL_SYNC=postgresql://mt5user:mt5password@postgres:5432/mt5_quant
PG_USER=mt5user
PG_PASSWORD=mt5password
PG_DB=mt5_quant
PG_HOST=postgres
PG_PORT=5432

# ──────────── Redis ────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────── Celery ────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ──────────── Authentication ────────────
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────── CORS ────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────── Application ────────────
APP_NAME=MT5 Quant Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true

# ──────────── MetaTrader 5 ────────────
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# ──────────── Email (SMTP) ────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mt5quant.local
SMTP_USE_TLS=true

# ──────────── Rate Limiting ────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ──────────── Sentry (Error Tracking) ────────────
SENTRY_DSN=

# ──────────── Feature Flags ────────────
FEATURE_LIVE_TRADING=false
FEATURE_PAPER_TRADING=true
FEATURE_BACKTESTING=true
FEATURE_ALERTS=true